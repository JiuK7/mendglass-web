# Environment variables for mendglass-web.
#
# Copy this file to .env.local for local development. Never commit real values.
# This file lists names and descriptions only. All of them are validated in
# src/lib/env.ts; the site refuses to start if they are wrong.
#
# Under `pnpm dev` and the unit tests, with nothing set, the site runs as
# development with the test sink, which accepts enquiries and delivers them
# nowhere.

# Which environment this is: development, preview or production.
# Required in every production build: `pnpm build` + `pnpm start`,
# `pnpm preview` and every deploy refuse to start without it. Only `pnpm dev`
# and the unit tests may leave it unset (it then means development).
# Only an explicit "production" counts as production; no host-specific
# variable is ever used to decide.
# Already set for you: the end-to-end tests (playwright.config.ts) and the
# workers.dev deploy (wrangler.jsonc) use preview. For `pnpm preview`, put
# SITE_ENV=preview in .dev.vars (gitignored).
SITE_ENV=

# Where enquiries go: test, email or n8n. Default: test.
# test delivers nowhere and is refused when SITE_ENV=production.
ENQUIRY_SINK=

# Required when ENQUIRY_SINK=email. Each enquiry is sent as one plain-text
# email through Resend's HTTP API, with Reply-To set to the enquirer.
# Setting these for `pnpm dev` sends real email.
# A Resend API key with sending access only. Secret: only here in
# .env.local or .dev.vars, and as a Worker secret (wrangler secret put).
RESEND_API_KEY=
# The sender, on the verified sending subdomain (send.mendglass.com).
# May include a display name, such as: Name <address@send.mendglass.com>
ENQUIRY_EMAIL_FROM=
# The inbox that receives enquiries.
ENQUIRY_EMAIL_TO=

# Required when ENQUIRY_SINK=n8n (the n8n sink is built in Brief 22).
# The workflow's webhook address (https only).
N8N_WEBHOOK_URL=
# The secret the webhook requires in a header. Secret.
N8N_WEBHOOK_SECRET=
